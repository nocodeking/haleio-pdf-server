# HALEIO PDF Generator Server
# Run: node server.js
# Deploy: docker build -t haleio-pdf . && docker run -p 3002:3002 haleio-pdf

PORT=3002
# Email — choose one:
# Option A: Resend (recommended — better deliverability)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Option B: SMTP (use existing email creds)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=hello@haleio.com
# SMTP_PASS=yourpassword
# SMTP_FROM="HALEIO <hello@haleio.com>"

# Required for email to work — if not set, PDF is saved locally only
# EMAIL_FROM="HALEIO <hello@haleio.com>"

# Darren gets notified on every submission
# NOTIFY_EMAIL=darren@haleio.com
